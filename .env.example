# ── Токен чат-бота MAX ──────────────────────────────────────────────
# Выдаётся организаторами хакатона / в кабинете business.max.ru.
# Если пусто — приложение запускается в DEV-режиме: вход без подписи (демо-житель),
# бот работает как заглушка (сообщения пишутся в консоль). Так решение проверяется локально.
MAX_BOT_TOKEN=

# База Bot API MAX (по умолчанию platform-api.max.ru).
MAX_API_BASE=https://platform-api.max.ru

# HTTPS-URL мини-приложения (для кнопки «Открыть» в боте после /start).
MINIAPP_URL=

# Порт HTTP-сервера.
PORT=3000

# Каталог для файлового хранилища данных (JSON).
DATA_DIR=./backend/data

# Максимальный возраст стартовых данных MAX в секундах (защита от replay).
LAUNCH_MAX_AGE_SEC=86400
